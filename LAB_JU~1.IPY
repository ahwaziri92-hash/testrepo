   "source": [
    "site_map2 = folium.Map(location=nasa_coordinate, zoom_start=5)\n",
    "for _, row in launch_sites_df.iterrows():\n",
    "    coordinate = [row['Lat'], row['Long']]\n",
    "    folium.Circle(coordinate, radius=1000, color='#d35400', fill=True).add_child(\n",
    "        folium.Popup(row['Launch Site'])\n",
    "    ).add_to(site_map2)\n",
    "    folium.map.Marker(\n",
    "        coordinate,\n",
    "        icon=DivIcon(icon_size=(20, 20), icon_anchor=(0, 0),\n",
    "                     html='<div style=\"font-size: 12; color:#d35400;\"><b>%s</b></div>' % row['Launch Site']),\n",
    "    ).add_to(site_map2)\n",
    "\n",
    "site_map2.add_child(marker_cluster)\n",
    "\n",
    "for _, record in spacex_df.iterrows():\n",
    "    marker = folium.Marker(\n",
    "        [record['Lat'], record['Long']],\n",
    "        icon=folium.Icon(color='white', icon_color=record['marker_color']),\n",
    "        popup=f\"{record['Launch Site']} - {'Success' if record['class'] == 1 else 'Failure'}\",\n",
    "    )\n",
    "    marker_cluster.add_child(marker)\n",
    "\n",
    "site_map2"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "be9e8084",
   "metadata": {},
   "source": [
    "From the color-labeled markers in the cluster, KSC LC-39A and CCAFS SLC-40 show visibly more green (successful) markers than red, indicating relatively higher success rates at those pads."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1250a3ea",
   "metadata": {},
   "source": [
    "## TASK 3: Calculate the distances between a launch site and its proximities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "af4f1645",
   "metadata": {},
   "outputs": [],
   "source": [
    "from math import sin, cos, sqrt, atan2, radians\n",
    "\n",
    "def calculate_distance(lat1, lon1, lat2, lon2):\n",
    "    # approximate radius of earth in km\n",
    "    R = 6373.0\n",
    "    lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])\n",
    "    dlon = lon2 - lon1\n",
    "    dlat = lat2 - lat1\n",
    "    a = sin(dlat / 2) ** 2 + cos(lat1) * cos(lat2) * sin(dlon / 2) ** 2\n",
    "    c = 2 * atan2(sqrt(a), sqrt(1 - a))\n",
    "    return R * c"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a6755e76",
   "metadata": {},
   "source": [
    "We compute the distance from Cape Canaveral SLC-40 to the nearest coastline point (identified\n",
    "via map inspection at approximately 28.56367 N, -80.57163 W, just east of the pad)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "bb895534",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Distance from CCAFS SLC-40 to nearest coastline point: 0.51 km\n"
     ]
    }
   ],
   "source": [
    "launch_site_lat, launch_site_lon = 28.563197, -80.576820  # CCAFS SLC-40\n",
    "coastline_lat, coastline_lon = 28.56367, -80.57163\n",
    "\n",
    "distance_coastline = calculate_distance(launch_site_lat, launch_site_lon, coastline_lat, coastline_lon)\n",
    "print(f\"Distance from CCAFS SLC-40 to nearest coastline point: {distance_coastline:.2f} km\")"
   ]
  },
